        "blue": {
          "alpha": 0.3,
          "node": "1925:9940",
          "frame": "1902:5245"
        }
      },
      "selectedRing": "accent @ alpha 0.30, 4 px",
      "text/glyph on accent": "Dark/FG/B1 #161616"
